# ─── Tooling caches ───
.venv/
__pycache__/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
jieba.cache
.vscode/
# Project-local pip download cache + build temp, deliberately off the C: drive.
.pip-cache/
.tmp/

# ─── Runtime state ───
# data/ holds runs.db / datasets.db / cookies / exports. A saved workflow is authored work and IS
# versioned: it references datasets by id, so a checkout is only useful beside the same data/.
data/*
!data/workflows/
!data/workflows/**
!data/model_registry.json
logs/
scratchpad/

# Restore points from tools/backup.py (a git bundle + a data archive; may hold cookies).
backups/

# ─── Sources that stay on this machine ───
# backend/test_*.py are one-off live-site probes: they assert nothing and would land in CI's ruff and
# pytest. They are linted locally with `.pylintrc.probes`, never in CI (a runner has none of them).
backend/test_*.py
# Real vendor exports are licence-restricted; the committed *_demo.* fixtures beside them carry the
# same columns and separators, so every dialect is still tested without shipping anyone's data.
samples/vendor/

# ─── Built documents (PDF) stay local ───
# docs/*.md is the project's OWN documentation (AGENTS.md keeps it true to the code) and IS versioned.
# A compiled PDF is a build product, not source: the 使用手册 beside its .tex is rebuilt from that source,
# so the .tex/figures are what get committed and the PDF never is. LaTeX's own droppings follow it out.
*.pdf
*.aux
*.log
*.toc
*.out
*.lof
*.lot
*.fls
*.fdb_latexmk
*.synctex.gz
# OpenChamber's screenshot cache (raw captures; the curated figures live under docs/manual/img/).
.openchamber/

# ─── ml_train ───
# Big/private subdirs stay out (datasets = crawled content, models = ~1.6G weights); the scripts and
# the dir-map README are versioned so every cited accuracy has its producing code in the repo.
ml_train/*
!ml_train/scripts/
!ml_train/README.md

# ─── Desktop build ───
# The build env, PyInstaller work dir and artifacts are reproducible from desktop/.
build/
dist/
desktop/.venv-build/
desktop/.pyinstaller-cache/
desktop/bootstrap/.pyinstaller-cache/
# PyInstaller/matplotlib scratch that can appear beside the checkout on a restricted box.
tmp*/fontlist-*.json
# pip falls back to cwd for scratch dirs on a restricted Windows sandbox.
pip-build-*/
pip-install-*/
pip-unpack-*/
pip-ephem-wheel-cache-*/
