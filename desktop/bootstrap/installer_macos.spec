# PyInstaller spec for the macOS online installer (a small windowed .app + DMG).
#
# The entry imports the shared installer by PATH (it is a script, not a package), so PyInstaller
# cannot follow those imports itself: every runtime module is listed in hiddenimports or copied as a
# data file. The catalogue is generated by build_macos_installer.py and carries the SHA-256 of the
# exact application DMG this installer downloads.
#
# No WebView2/pythonnet: the window is Cocoa/WebKit through pywebview. No pandas/numpy/matplotlib:
# the installer only downloads and unpacks components.

import os
import sys
from pathlib import Path

BOOTSTRAP = Path(SPECPATH).resolve()
ROOT = BOOTSTRAP.parent.parent
BACKEND = ROOT / 'backend'
CATALOG = os.environ.get('CIXI_INSTALLER_CATALOG') or str(BACKEND / 'services' / 'components' / 'default_catalog.json')
ICON = os.environ.get('CIXI_MACOS_ICON') or ''
if str(BACKEND) not in sys.path:
    sys.path.insert(0, str(BACKEND))

datas = [
    (CATALOG, '.'),
    (str(BOOTSTRAP / 'installer.py'), '.'),
    (str(BOOTSTRAP / 'plan.py'), '.'),
    (str(BOOTSTRAP / 'installer_page.html'), '.'),
    (str(BOOTSTRAP / 'installer_page.js'), '.'),
    (str(BACKEND / 'static' / 'icon.ico'), '.'),
    (str(ROOT / 'desktop' / 'native_window.py'), '.'),
]

hiddenimports = [
    'webview',
    'webview.platforms.cocoa',
    'objc',
    'Foundation',
    'AppKit',
    'WebKit',
    'PyObjCTools.AppHelper',
    'services.components.catalog',
    'services.components.manifest',
    'services.components.fetch',
    'services.components.archive',
    'services.components.install',
    'services.components.macos',
    'services.components.paths',
    'core.machine',
    'core.procs',
    'core.config',
]

excludes = [
    'torch',
    'torchvision',
    'torchaudio',
    'transformers',
    'sentence_transformers',
    'pyarrow',
    'mitmproxy',
    'mitmproxy_rs',
    'uiautomation',
    'tkinter',
    '_tkinter',
    'PyQt5',
    'PyQt6',
    'PySide2',
    'PySide6',
    'IPython',
    'jupyter',
    'notebook',
    'pytest',
    'pytest_cov',
    'pytest_socket',
    'pytest_timeout',
    'ruff',
    'pylint',
    'webdriver_manager',
    'tabulate',
    'pandas',
    'numpy',
    'scipy',
    'sklearn',
    'matplotlib',
    'PIL',
    'openpyxl',
    'jieba',
    'snownlp',
    'yaml',
    'requests',
    'sessions',
    'analyzers',
    'api',
    'engine',
    'nodes',
    'scheduling',
    'capabilities',
    'crawlers',
    'tzdata',
    'sqlite3',
    'decimal',
]

a = Analysis(
    [str(BOOTSTRAP / 'installer_macos.py')],
    pathex=[str(BACKEND), str(BOOTSTRAP), str(ROOT / 'desktop')],
    binaries=[],
    datas=datas,
    hiddenimports=hiddenimports,
    hookspath=[],
    hooksconfig={},
    runtime_hooks=[],
    excludes=excludes,
    noarchive=False,
    optimize=1,
)

pyz = PYZ(a.pure)

exe = EXE(
    pyz,
    a.scripts,
    [],
    exclude_binaries=True,
    name='CaiXiHui-Online-Setup',
    debug=False,
    bootloader_ignore_signals=False,
    strip=False,
    upx=False,
    console=False,
    disable_windowed_traceback=False,
    argv_emulation=False,
    target_arch=None,
    codesign_identity=None,
    entitlements_file=None,
)

coll = COLLECT(
    exe,
    a.binaries,
    a.datas,
    strip=False,
    upx=False,
    name='CaiXiHui-Online-Setup',
)

app = BUNDLE(
    coll,
    name='CaiXiHui-Online-Setup.app',
    icon=ICON or None,
    bundle_identifier='com.caixihui.installer',
    info_plist={
        'CFBundleDisplayName': '采析绘安装器',
        'CFBundleName': 'CaiXiHui-Online-Setup',
        'CFBundleShortVersionString': '1.0.0',
        'NSHighResolutionCapable': True,
        'LSMinimumSystemVersion': '11.0',
        'LSApplicationCategoryType': 'public.app-category.utilities',
    },
)
