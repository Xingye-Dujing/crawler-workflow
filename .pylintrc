# Product standard: `backend/` modules (the `backend/test_*.py` measurement scripts get
# `.pylintrc.probes`), plus `packaging/` and `tools/`.
#
# The gate is `pylint` exiting clean — not a score. Anything this file does not enable is
# still checked; the list below is short, deliberate and explained, and an inline
# `# pylint: disable` is never acceptable (AGENTS.md).

[MAIN]
# What pytest already guarantees at run time: `backend/` is the import root (the app is run
# from there, so `from config import Config` is a top-level import) and a test module may
# import its sibling helpers. Without this, pylint reports import-error for code that runs.
# Two plain statements, not a comprehension: pylint execs this hook inside a function, where an
# `import` binds to that frame's locals and a comprehension cannot see them.
init-hook="import sys; sys.path.insert(0, 'backend'); sys.path.insert(0, 'tests/unit')"

[MESSAGES CONTROL]
# Every entry is a written-down standard choice, not a way to look green:
#   C0114/C0115/C0116  docstrings. This project documents the WHY in prose that explains a
#                      decision; a generated "Get the foo" line is the noise AGENTS forbids.
#                      Documented behaviour lives in README/docs and in the tests instead.
#   C0302              too-many-lines. `services/data_analysis.py` and `services/bibliometrics.py`
#                      are one domain each; splitting them to satisfy a counter would scatter
#                      related invariants across files.
#   R0903/R0911/R0912/R0913/R0914/R0915/R0917  size and shape counters. Pipeline steps and crawler
#                      bodies are long because the subject is; the review here is the fast test
#                      tier and the auditors, not a line budget.
#   R0801              duplicate-code. The ten bibliographic format parsers are similar because
#                      the export formats are; collapsing them would couple unrelated vendors.
#   W0718              broad-except. Used on purpose for best-effort side effects (disk mirrors,
#                      log sinks, cleanup) where each site states in a comment why a failure must
#                      not end a run.
#   W0603              global-statement. Every one of the 14 sites is process state that a caller
#                      deliberately rebinds: the store singletons in `stores.py` (the seam a test
#                      conftest uses to point the app at a tmp data root), `settings_store`'s
#                      cached values, `state.set_log_sink`, the scheduler's starter/canvas seams
#                      and its tick counters. A `global` IS the mechanism there; wrapping it in an
#                      object would move the same mutability behind a setter and change nothing.
disable=C0114,C0115,C0116,C0302,R0902,R0904,R0903,R0911,R0912,R0913,R0914,R0915,R0917,R0801,W0718,W0603

[FORMAT]
# Line width is NOT switched off: it is pinned to ruff's 120 so the two tools cannot disagree
# about the same line. (It was disabled before, which let a line pass ruff and fail nothing.)
max-line-length=120

[BASIC]
# `sys._current_frames()` is the only way to ask where a thread that will not return is standing,
# and `app.py`'s hang forensics needs it (a wedged `close()` logs nothing anyone will ever hear).
# Named per member, not per message: every other protected access is still a finding to fix.
exclude-protected=_current_frames

